def compat_issues(e, ptype, vtype):
    """Return a list of messages about using BC e on a mesh patch of type ptype."""
    msgs = []
    if vtype and vtype not in e["types"]:
        msgs.append(f"'{e['name']}' does not exist for {vtype} fields "
                    f"(available: {', '.join(e['types'])})")
    if not ptype:
        return msgs
    chain = [e["name"]] + e.get("ancestors", [])
    if ptype in CONSTRAINT_PATCH_TYPES:
        if ptype not in chain and not (ptype == "processor" and "processorCyclic" in chain):
            msgs.append(f"mesh patch type is '{ptype}': the boundary condition must be "
                        f"'{ptype}' (or derived from it), not '{e['name']}'")
    elif e["constraint"] and e["name"] not in ("calculatedProcessor",):
        msgs.append(f"'{e['name']}' is a constraint type; the mesh patch type must be "
                    f"'{e['name']}' but it is '{ptype}'")
    if e["wallOnly"] and ptype and ptype != "wall":
        msgs.append(f"'{e['name']}' aborts unless the mesh patch type is 'wall' "
                    f"(this patch is '{ptype}')")
    return msgs


def compat_warnings(e, ptype):
    if e.get("wallFunction") and not e["wallOnly"] and ptype and ptype != "wall":
        return [f"'{e['name']}' is a wall function intended for patches of type 'wall' "
                f"(this patch is '{ptype}')"]
    return []


def missing_required(e, keys, db):
    if not e["tables"]:
        return []
    req = []
    for t in e["tables"]:
        for r in t["rows"]:
            if r["reqd"] == "yes" and re.match(r"^\w+$", r["name"]) and r["name"] != "type":
                req.append(r["name"])
    return [k for k in dict.fromkeys(req) if k not in keys]


def cmd_check(args):
    db = load_db()
    case = case_or_exit(args)
    mp = mesh_patches(case, args.region)
    fdir = field_dir(case, args.region, args.time)
    fields = case_fields(fdir)
    if args.fields:
        want = args.fields.replace(",", " ").split()
        fields = {k: v for k, v in fields.items() if k in want}
    if not fields:
        sys.exit(f"Error: no field files found in {fdir}")
    if mp is None:
        eprint(c("Note: constant/polyMesh/boundary not found (run blockMesh first); "
                 "patch names are taken from the field files and patch types are unknown.",
                 "1;33", sys.stderr))
    errors, warnings = [], []
    table = collections.OrderedDict()
    for fname, (fpath, fkind, vt, dims) in fields.items():
        pats, directives = boundary_patches(fpath, case=case)
        if pats is None:
            warnings.append(f"{fname}: no boundaryField")
            continue
        uses_constraint_include = any("setConstraintTypes" in d for d in directives)
        has_unresolved = any(d.startswith("$") or d.startswith("#include") for d in directives)
        names = mp if mp is not None else {p["key"]: {"type": "?", "groups": []}
                                           for p in pats if not p["quoted"]}
        for pname, pinfo in names.items():
            ptype = pinfo["type"]
            p = match_patch(pats, pname, pinfo["groups"] + [ptype])
            cell = table.setdefault(pname, {})
            if p is None:
                if uses_constraint_include and ptype in CONSTRAINT_PATCH_TYPES:
                    cell[fname] = ptype + "*"
                    continue
                cell[fname] = c("MISSING", "1;31")
                (warnings if has_unresolved else errors).append(
                    f"{fname}: no entry for patch '{pname}' ({ptype})"
                    + (" - maybe defined via $/#include" if has_unresolved else ""))
                continue
            t = p["type"]
            cell[fname] = t or "?"
            if not t:
                if p["unresolved"]:
                    cell[fname] = "($macro)"
                else:
                    errors.append(f"{fname}/{pname}: entry '{p['key']}' has no 'type'")
                continue
            e = lookup(db, t, fkind, exit_on_fail=False)
            if e is None:
                other = lookup(db, t, "fv" if fkind == "point" else "point", exit_on_fail=False)
                short = t.split("::")[-1]
                close = [short] if short != t and short in db[fkind] else \
                    difflib.get_close_matches(t, list(db[fkind]), n=1, cutoff=0.8)
                hint = f" (did you mean '{close[0]}'?)" if close else ""
                if other:
                    hint = f" ('{t}' is a {'point' if fkind == 'fv' else 'fv'} patch field)"
                errors.append(f"{fname}/{pname}: unknown {fkind} boundary condition '{t}'"
                              + (hint or " (not in OpenFOAM; a user library loaded via 'libs'?)"))
                cell[fname] = c(t + "?", "1;31")
                continue
            for msg in compat_issues(e, ptype if mp is not None else None, vt):
                errors.append(f"{fname}/{pname}: {msg}")
                cell[fname] = c(t + "!", "1;31")
            for msg in compat_warnings(e, ptype if mp is not None else None):
                warnings.append(f"{fname}/{pname}: {msg}")
            if not p["unresolved"]:
                miss = missing_required(e, p["keys"], db)
                if miss:
                    warnings.append(f"{fname}/{pname}: '{t}' - header lists as required: "
                                    f"{', '.join(miss)} (check: foamBC show {t})")
        if mp is not None:
            for p in pats:
                if not p["quoted"] and p["key"] not in mp and \
                        not any(p["key"] in v["groups"] or p["key"] == v["type"]
                                for v in mp.values()) and "from" not in p:
                    warnings.append(f"{fname}: entry '{p['key']}' matches no mesh patch")
    # Patch x field table (vertical layout when it is too wide)
    fl = list(fields)
    wp = max([len(p) for p in table] + [5])
    try:
        shown_dir = fdir.relative_to(case)
    except ValueError:
        shown_dir = fdir
    print(c(f"Case {case}  (fields from {shown_dir})", "1"))
    plain = lambda v: re.sub(r"\033\[[\d;]*m", "", v)
    widths = {f: max([len(f)] + [len(plain(r.get(f, "-"))) for r in table.values()]) for f in fl}
    total = wp + 16 + sum(w + 2 for w in widths.values())
    cols = shutil.get_terminal_size((160, 20)).columns
    if total <= cols:
        print(f"{'patch'.ljust(wp)}  {'meshType':<14}" + "".join(f"  {f.ljust(widths[f])}" for f in fl))
        for pname, row in table.items():
            ptype = mp[pname]["type"] if mp is not None else "?"
            cells = "".join("  " + row.get(f, "-") + " " * (widths[f] - len(plain(row.get(f, "-"))))
                            for f in fl)
            print(f"{c(pname.ljust(wp), '1;36')}  {ptype:<14}{cells}")
    else:
        for pname, row in table.items():
            ptype = mp[pname]["type"] if mp is not None else "?"
            print(f"{c(pname, '1;36')}  ({ptype})")
            for f in fl:
                if f in row:
                    print(f"    {f:<14} {row[f]}")
    print()
    for m in errors:
        print(c("ERROR   ", "1;31") + m)
    for m in warnings:
        print(c("WARNING ", "1;33") + m)
    if not errors and not warnings:
        print(c("OK: every patch has a valid boundary condition in every field.", "1;32"))
    print(f"\n{len(errors)} error(s), {len(warnings)} warning(s)."
          + ("  (* = set by #includeEtc caseDicts/setConstraintTypes)" if
             any("*" in v for r in table.values() for v in r.values()) else ""))
    sys.exit(1 if errors else 0)


