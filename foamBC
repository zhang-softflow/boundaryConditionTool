def read_text(path):
    try:
        path = Path(path)
        if path.suffix == ".gz":
            with gzip.open(path, "rt", encoding="utf-8", errors="replace") as f:
                return f.read()
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def strip_comments(text):
    """Remove C/C++ comments (string literals are not expected here)."""
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return re.sub(r"//[^\n]*", "", text)


def mask_comments(text):
    """Replace comments by blanks, keeping offsets and newlines (strings aware)."""
    out = list(text)
    i, n = 0, len(text)
    while i < n:
        ch = text[i]
        if ch == '"':
            j = text.find('"', i + 1)
            i = n if j < 0 else j + 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
            for k in range(i, j):
                out[k] = " "
            i = j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            j = n if j < 0 else j + 2
            for k in range(i, j):
                if out[k] != "\n":
                    out[k] = " "
            i = j
        else:
            i += 1
    return "".join(out)


def header_comment(text):
    """Return the leading documentation comment block of a source file."""
    m = re.search(r"\\\*-{5,}[-*]*\*/", text)
    if not m:
        return ""
    block = text[: m.start()]
    idx = block.find("\nClass")
    if idx < 0:
        idx = block.find("\nDescription")
    return block[idx + 1:] if idx >= 0 else block


def split_sections(comment):
    """Split a doxygen header comment into {SectionName: text}."""
    sections = {}
    current = None
    buf = []

    def flush():
        if current:
            old = sections.get(current)
            txt = "\n".join(buf)
            sections[current] = old + "\n\n" + txt if old else txt
    for line in comment.splitlines():
        m = SECTION_RE.match(line)
        if m and not line.startswith(" "):
            flush()
            current = m.group(1).strip()
            buf = []
        elif current:
            buf.append(line)
    flush()
    return sections


def dedent(text):
    lines = text.splitlines()
    ind = [len(l) - len(l.lstrip()) for l in lines if l.strip()]
    cut = min(ind) if ind else 0
    return "\n".join(l[cut:] for l in lines).strip("\n")


def extract_verbatims(text):
    """Return \\verbatim blocks; tolerate a missing \\endverbatim."""
    out = []
    parts = re.split(r"\\verbatim[ \t]*\n", text)
    for part in parts[1:]:
        end = part.find("\\endverbatim")
        if end >= 0:
            out.append(dedent(part[:end]))
            continue
        lines = part.splitlines()
        first = next((l for l in lines if l.strip()), "")
        ind = len(first) - len(first.lstrip())
        blk = []
        for l in lines:
            blk.append(l)
            if l.strip() == "}" and len(l) - len(l.lstrip()) == ind:
                break
        out.append(dedent("\n".join(blk)))
    return out


def clean_doxygen(text):
    """Remove doxygen markup from prose."""
    text = re.sub(r"\\verbatim.*?\\endverbatim", "", text, flags=re.S)
    text = re.sub(r"\\table.*?\\endtable", "", text, flags=re.S)
    text = re.sub(r"<!--\s*\n\s*-->", " ", text)
    text = LINK_RE.sub(r"\1", text)
    text = re.sub(r"\\(c|a|b|em|p)\s+", "", text)
    text = re.sub(r"\\vartheta", "theta", text)
    text = re.sub(r"\\(end)?vartable", "", text)
    text = re.sub(r"\\heading\s+", "", text)
    text = re.sub(r"\\f\[.*?\\f\]", "[formula]", text, flags=re.S)
    text = re.sub(r"\\f\$(.*?)\\f\$", r"\1", text, flags=re.S)
    text = text.replace("\\<", "<").replace("\\>", ">")
    text = re.sub(r"\n\s*\n\s*\n+", "\n\n", text)
    return dedent(text)


def parse_tables(text):
    """Parse every \\table ... \\endtable block into a list of row dicts."""
    tables = []
    for m in re.finditer(r"(?:\\heading\s+([^\n]*)\n\s*)?\\table\s*\n(.*?)\\endtable",
                         text, re.S):
        heading = (m.group(1) or "").strip()
        body = re.sub(r"<!--\s*\n\s*-->", " ", m.group(2))
        body = body.replace("\\<", "<").replace("\\>", ">")
        lines = [l.strip() for l in body.splitlines() if "|" in l]
        if not lines:
            continue
        head = [c_.strip().lower() for c_ in lines[0].split("|")]
        cols = {}
        for i, h in enumerate(head):
            if h.startswith("prop") or h in ("entry", "keyword", "name"):
                cols.setdefault("name", i)
            elif h.startswith("desc"):
                cols.setdefault("desc", i)
            elif h.startswith("type"):
                cols.setdefault("type", i)
            elif h.startswith("req") or h.startswith("mand"):
                cols.setdefault("reqd", i)
            elif h.startswith("def") or h.startswith("dflt"):
                cols.setdefault("default", i)
        if "name" not in cols:
            continue
        rows = []
        for l in lines[1:]:
            cells = [c_.strip() for c_ in l.split("|")]

            def cell(key):
                i = cols.get(key)
                return cells[i] if i is not None and i < len(cells) else ""
            name = cell("name")
            if not name:
                continue
            reqd = cell("reqd").lower()
            if reqd.startswith(("yes", "y")):
                reqd = "yes"
            elif reqd.startswith("no") or reqd.startswith("opt"):
                reqd = "no"
            elif reqd.startswith(("cnd", "cond")):
                reqd = "cond"
            rows.append({
                "name": name,
                "desc": re.sub(r"\s+", " ", LINK_RE.sub(r"\1", cell("desc"))),
                "type": cell("type"),
                "reqd": reqd,
                "default": cell("default").strip("-").strip() if cell("default") != "-" else "",
            })
        if rows:
            tables.append({"heading": heading, "rows": rows})
    return tables


def lib_from_make(path):
    """Find the library a source belongs to via the nearest Make/files.

    Returns the library name, "" for solver-local sources (EXE) or None.
    """
    d = Path(path).parent
    for _ in range(10):
        mf = d / "Make" / "files"
        if mf.is_file():
            txt = read_text(mf)
            m = re.search(r"^\s*LIB\s*=\s*\$\(FOAM_\w+\)/lib(\w+)", txt, re.M)
            if m:
                return m.group(1)
            if re.search(r"^\s*EXE\s*=", txt, re.M):
                return ""
        if d.parent == d:
            break
        d = d.parent
    return None


def find_brace_end(text, i):
    """Return the index of the brace closing the one at text[i] (masked text)."""
    depth = 0
    for j in range(i, len(text)):
        ch = text[j]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return j
    return None


ENTRY_RE = re.compile(r'\s*("[^"]*"|[^\s{};"]+)')


def dict_entries(masked, start, end):
    """Parse the entries of a dictionary body masked[start:end].

    Yields dicts with: key, kind ('dict' | 'value' | 'directive'), start
    (offset of the key), end (offset after the entry), body (start, end) of
    the sub-dictionary contents for kind 'dict'.
    """
    i = start
    while i < end:
        m = ENTRY_RE.match(masked, i, end)
        if not m:
            break
        key = m.group(1)
        ks = m.start(1)
        j = m.end()
        if key.startswith("#"):
            nl = masked.find("\n", j)
            nl = end if nl < 0 or nl > end else nl
            yield {"key": key, "kind": "directive", "start": ks, "end": nl,
                   "text": masked[ks:nl].strip()}
            i = nl
            continue
        # Skip blanks
        while j < end and masked[j] in " \t\r\n":
            j += 1
        if j < end and masked[j] == "{":
            be = find_brace_end(masked, j)
            if be is None or be >= end:
                break
            yield {"key": key.strip('"'), "quoted": key.startswith('"'), "kind": "dict",
                   "start": ks, "end": be + 1, "body": (j + 1, be)}
            i = be + 1
            continue
        # Value entry up to ';' (no braces at this level)
        semi = masked.find(";", j)
        if key.endswith(";"):
            yield {"key": key.rstrip(";"), "kind": "value", "start": ks, "end": m.end(),
                   "value": ""}
            i = m.end()
            continue
        if semi < 0 or semi > end:
            break
        yield {"key": key, "kind": "value", "start": ks, "end": semi + 1,
               "value": masked[j:semi].strip()}
        i = semi + 1


def entry_type(masked, body):
    """Return the 'type' value at depth 0 of a sub-dictionary body."""
    for e in dict_entries(masked, body[0], body[1]):
        if e["kind"] == "value" and e["key"] == "type":
            return e["value"]
    return None


def entry_keys(masked, body):
    return [e["key"] for e in dict_entries(masked, body[0], body[1])]


def find_boundary_field(masked):
    """Return (key_start, body_start, body_end) of the top-level boundaryField."""
    for e in dict_entries(masked, 0, len(masked)):
        if e["kind"] == "dict" and e["key"] == "boundaryField":
            return e["start"], e["body"][0], e["body"][1]
    return None


def resolve_include(name, base_dir, case=None, root=None, etc=False):
    name = name.strip().strip('"')
    if case is not None:
        name = name.replace("$FOAM_CASE", str(case)).replace("${FOAM_CASE}", str(case))
    if etc:
        for r in [root, project_dir(None, required=False)]:
            if r and (Path(r) / "etc" / name).is_file():
                return Path(r) / "etc" / name
        return None
    p = Path(name)
    if not p.is_absolute():
        p = Path(base_dir) / p
    return p if p.is_file() else None


def boundary_patches(path, text=None, case=None, depth=0):
    """Return (patches, directives) of the boundaryField of a field file.

    patches: list of dicts {key, type, keys, quoted, block} in file order;
    entries from #include / #includeEtc files are expanded (best effort).
    """
    if text is None:
        text = read_text(path)
    masked = mask_comments(text)
    bf = find_boundary_field(masked)
    if not bf:
        return None, []
    patches, directives = [], []
    for e in dict_entries(masked, bf[1], bf[2]):
        if e["kind"] == "dict":
            patches.append({
                "key": e["key"], "quoted": e.get("quoted", False),
                "type": entry_type(masked, e["body"]),
                "keys": entry_keys(masked, e["body"]),
                "block": text[text.rfind("\n", 0, e["start"]) + 1: e["end"]],
                "unresolved": "$" in masked[e["body"][0]:e["body"][1]]
                              or "#" in masked[e["body"][0]:e["body"][1]],
            })
        elif e["kind"] == "directive":
            directives.append(e["text"])
            m = re.match(r"#(include|includeEtc|sinclude|includeIfPresent)\s+(\S+)", e["text"])
            if m and depth < 3:
                inc = resolve_include(m.group(2), Path(path).parent, case,
                                      etc=m.group(1) == "includeEtc")
                if inc:
                    sub = read_text(inc)
                    # The included file holds the patch entries directly
                    fake = "boundaryField\n{\n" + sub + "\n}\n"
                    p2, d2 = boundary_patches(inc, fake, case, depth + 1)
                    for p in p2 or []:
                        p["from"] = str(inc)
                    patches.extend(p2 or [])
                    directives.extend(d2)
        elif e["kind"] == "value" and e["key"].startswith("$"):
            directives.append(e["key"])
    return patches, directives


