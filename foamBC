# ---------------------------------------------------------------------------

def mandatory_lines(example):
    """Return one-line mandatory entries at depth 1 of a base-class example."""
    out = []
    section = "mandatory"
    depth = 0
    for l in example.splitlines():
        s = l.strip()
        low = s.lower()
        if depth == 1 and low.startswith("//"):
            if "optional" in low and "mandatory/optional" not in low or "conditional" in low:
                section = "optional"
            elif "mandatory/optional" in low:
                section = "other"
            elif "mandatory" in low:
                section = "mandatory"
        elif depth == 1 and section == "mandatory" and re.match(r"^\w+\s+[^{]*;", s) \
                and not s.startswith("type"):
            out.append(s)
        depth += s.count("{") - s.count("}") if not s.startswith("//") else 0
    return out


def add_base_entries(e, text, bases):
    """Insert the mandatory entries documented in the inherited headers."""
    if not bases:
        return text
    live = strip_comments(text)
    for b in e["inherited"]:
        # Entries of a parent boundary condition (e.g. inletValue of
        # inletOutlet) are usually set by the derived class itself
        if b not in bases or re.search(r"(Fv|Point)Patch\w*Fields?\.H$", b):
            continue
        req = {r["name"] for t in bases[b]["tables"] for r in t["rows"] if r["reqd"] == "yes"}
        add = [l for l in mandatory_lines(bases[b].get("example", ""))
               if l.split()[0] in req and
               not re.search(r"^\s*" + re.escape(l.split()[0]) + r"\s", live, re.M)]
        if add:
            block = f"\n    // Mandatory entries from {b}\n" + "".join(f"    {l}\n" for l in add)
            text = re.sub(r"(^\s*type\s+[\w:.<>]+\s*;[^\n]*\n)", lambda m: m.group(1) + block,
                          text, count=1, flags=re.M)
            live = strip_comments(text)
    return text


def build_entry(e, patch, mode="minimal", bases=None):
    """Create a patch entry from the header example."""
    ex = e["example"]
    if not ex or not TYPE_ENTRY_RE.search(ex):
        ex = "{0}\n{{\n    type            {1};\n}}".format(patch, e["name"])
    lines = ex.splitlines()
    for i, l in enumerate(lines):
        if l.strip() and not l.strip().startswith("//"):
            if re.match(r"^[\w<>.\-\"()|*]+$", l.strip()):
                lines[i] = patch
            break
    for i, l in enumerate(lines):
        m = TYPE_ENTRY_RE.match(l)
        if m:
            lines[i] = l.replace(m.group(1), e["name"], 1)
            break
    required = {r["name"] for t in e["tables"] for r in t["rows"] if r["reqd"] == "yes"}
    first = next((i for i, l in enumerate(lines) if l.strip() == "{"), None)
    last = max((i for i, l in enumerate(lines) if l.strip() == "}"), default=None)
    has_markers = any(l.strip().startswith("//") and "mandatory" in l.lower() for l in lines)
    out = []
    section = "mandatory"
    depth = 0
    for i, l in enumerate(lines):
        s = l.strip()
        low = s.lower()
        if depth <= 1 and low.startswith("//"):
            if "conditional" in low:
                section = "conditional"
            elif "optional" in low:
                section = "optional"
            elif "inherited" in low:
                section = "inherited"
            elif "mandatory" in low:
                section = "mandatory"
        nopen = s.count("{") - s.count("}") if not s.startswith("//") else 0
        if s in ("...", "// ..."):
            depth += nopen
            continue
        key = re.match(r"^([\w\-]+)\s", s + " ")
        is_req = depth == 1 and bool(key) and key.group(1) in required
        outer = first is None or i <= first or i == last
        keep_inherited = section == "inherited" and bool(key) and key.group(1) == "value"
        if outer or section == "mandatory" or is_req or keep_inherited or depth > 1:
            if depth > 1 and section not in ("mandatory",) and not is_req and mode != "full":
                depth += nopen
                continue
            out.append(l)
        elif mode == "full":
            if s and not s.startswith("//"):
                out.append(re.sub(r"^(\s*)", r"\1// ", l, count=1))
            else:
                out.append(l)
        depth += nopen
    clean = []
    for l in out:
        if not l.strip() and clean and not clean[-1].strip():
            continue
        clean.append(l)
    if mode != "full":
        clean = [l for j, l in enumerate(clean)
                 if not (l.strip().startswith("//") and
                         (j + 1 >= len(clean) or not clean[j + 1].strip()
                          or clean[j + 1].strip() == "}"))]
    out = [l for j, l in enumerate(clean)
           if not (not l.strip() and j + 1 < len(clean) and clean[j + 1].strip() == "}")]
    text = add_base_entries(e, "\n".join(out), bases)
    if mode == "full":
        present = set(re.findall(r"^\s*(?://\s*)?(\w+)\s", text, re.M))
        extra = [r for t in e["tables"] for r in t["rows"]
                 if r["name"] not in present and re.match(r"^\w+$", r["name"])]
        if extra:
            add = ["", "    // Further entries documented in the header:"]
            for r in extra:
                d = f" (default: {r['default']})" if r["default"] else ""
                add.append(f"    // {r['name']:<16} <{r['type'] or 'value'}>;  "
                           f"// {r['desc']}{d}")
            idx = text.rfind("}")
            text = text[:idx].rstrip("\n") + "\n" + "\n".join(add) + "\n" + text[idx:]
    return text


