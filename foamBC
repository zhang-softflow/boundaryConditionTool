def cmd_example(args):
    db = load_db()
    e = lookup(db, args.name, kind_of(args))
    root = project_dir(args.src, required=False)
    refs = e["tutorials"]
    if args.field:
        refs = [r for r in refs if field_category(Path(r.split("::")[0]).name.replace(".orig", ""))
                == field_category(args.field)] or refs
    if not refs:
        print(f"'{e['name']}' is not used in the tutorials. Header example:\n")
        print(e["example"])
        return
    if root is None:
        print("OpenFOAM tutorials not found (source the OpenFOAM environment or use "
              "--src). Patch entries using it:")
        for r in refs[: args.max * 3]:
            print("  " + r)
        return
    shown = 0
    for ref in refs:
        rel, patch = ref.split("::", 1)
