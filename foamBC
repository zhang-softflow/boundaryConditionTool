def parse_header(hpath):
    text = read_text(hpath)
    comment = header_comment(text)
    secs = split_sections(comment)
    usage = secs.get("Usage", "")
    desc_raw = secs.get("Description", "")
    verbs = extract_verbatims(usage) + extract_verbatims(desc_raw)
    tables = parse_tables(usage) + parse_tables(desc_raw)
    verbs = [v.replace("\\<", "<").replace("\\>", ">") for v in verbs]
    if not verbs or not tables:
        for ext in (".C", ".cxx"):
            src = Path(hpath).with_suffix(ext)
            if src.is_file():
                s2 = split_sections(header_comment(read_text(src)))
                for key in ("Usage", "Description"):
                    if not verbs:
                        verbs = [v.replace("\\<", "<").replace("\\>", ">")
                                 for v in extract_verbatims(s2.get(key, ""))]
                    if not tables:
                        tables = parse_tables(s2.get(key, ""))
    inherited = [i for i in dict.fromkeys(LINK_RE.findall(usage + desc_raw))
                 if i.endswith(".H") and i != Path(hpath).name]
    return {
        "text": text,
        "description": clean_doxygen(desc_raw),
        "verbatims": verbs,
        "tables": tables,
        "inherited": inherited,
        "seeAlso": clean_doxygen(secs.get("See also", "")),
        "note": clean_doxygen(secs.get("Note", "")),
    }


def pick_example(verbs, tnames):
    """Choose the verbatim block that is a usage example of one of 'tnames'."""
    for t in tnames:
        pat = re.compile(r"^\s*type\s+" + re.escape(t) + r"\s*;", re.M)
        for v in verbs:
            if pat.search(v):
                return v
    for v in verbs:
        if TYPE_ENTRY_RE.search(v) and "{" in v:
            return v
    for v in verbs:
        if "{" in v:
            return v
    return ""


def guess_group(rel):
    for frag, g in GROUP_RULES:
        if frag in rel:
            return g
    return "other"


def find_class_header(directory, cls):
    """Return the header in 'directory' declaring 'class cls'."""
    same = directory / (cls + ".H")
    if same.is_file():
        return same
    pat = re.compile(r"^\s*class\s+" + re.escape(cls) + r"\b\s*(?::|$|\n)", re.M)
    for h in sorted(directory.glob("*.H")):
        if pat.search(read_text(h)):
            return h
    # Typedef of a template: xxxFvPatchScalarField -> xxxFvPatchField.H
    base = re.sub(r"(FvPatch|PointPatch)(Scalar|Vector|SphericalTensor|SymmTensor|Tensor)Field$",
                  r"\1Field", cls)
    if base != cls and (directory / (base + ".H")).is_file():
        return directory / (base + ".H")
    tpat = re.compile(r"\btypedef\b[^;]*\b" + re.escape(cls) + r"\s*;", re.S)
    for h in sorted(directory.glob("*.H")):
        if tpat.search(read_text(h)):
            # Document the template class header, not the typedef header
            m = re.search(r"#include\s+\"(\w+\.H)\"", read_text(h))
            if m and (directory / m.group(1)).is_file():
                return directory / m.group(1)
            return h
    return None


def scan_registrations(root):
    """Return {(kind, typeName): info} of registered fv/point patch fields."""
    found = {}

    def add(kind, name, header, cls, vtypes, src):
        key = (kind, name)
        e = found.get(key)
        if e is None:
            found[key] = {"kind": kind, "name": name, "header": header, "cls": cls,
                          "types": list(vtypes), "src": src}
        else:
            for t in vtypes:
                if t not in e["types"]:
                    e["types"].append(t)

    for d in ("src", "applications", "modules"):
        if not (root / d).is_dir():
            continue
        for f in (root / d).rglob("*"):
            if f.suffix not in (".C", ".cxx") or not f.is_file():
                continue
            rel_parts = f.relative_to(root).parts
            if SKIP_DIRS.intersection(rel_parts):
                continue
            if rel_parts[:2] == ("applications", "test"):
                continue
            raw = read_text(f)
            if "PatchField" not in raw and "PatchTypeField" not in raw:
                continue
            text = strip_comments(raw)
            named = {m.group(1).split("::")[-1]: m.group(2)
                     for m in NAMED_TYPENAME_RE.finditer(text)}
            for m in REG_TEMPLATE_ALL.finditer(text):
                kind = "point" if m.group(1) else "fv"
                bc = m.group(2)
                cls = bc + ("PointPatchField" if kind == "point" else "FvPatchField")
                h = find_class_header(f.parent, cls)
                if h is None:
                    continue
                names = TYPENAME_RE.findall(read_text(h))
                add(kind, names[0] if names else bc, h, cls, VALUE_TYPES, f)
            for m in REG_TEMPLATE_ONE.finditer(text):
                vt, bc = m.group(1), m.group(2)
                cls = bc + "FvPatchField"
                h = find_class_header(f.parent, cls)
                if h is None:
                    continue
                names = TYPENAME_RE.findall(read_text(h))
                add("fv", names[0] if names else bc, h, cls, [vt], f)
            for m in REG_CLASS.finditer(text):
                macro, base, cls = m.groups()
                cls = cls.split("::")[-1]
                kind = "point" if "Point" in macro or re.search(r"[pP]ointPatch", base) else "fv"
                mv = re.search(r"Patch(Scalar|Vector|SphericalTensor|SymmTensor|Tensor)Field$", base)
                vt = CAP2TYPE.get(mv.group(1)) if mv else None
                if vt is None:
                    continue
                h = find_class_header(f.parent, cls)
                if h is None:
                    continue
                if cls in named:
                    name = named[cls]
                else:
                    names = TYPENAME_RE.findall(read_text(h))
                    if not names:
                        continue
                    name = names[0]
                add(kind, name, h, cls, [vt], f)
            # Extra names for patch-type constructors, e.g. 'overset' point fields
            for m in REG_NAMED.finditer(text):
                kindp, cap, cls, name = m.groups()
                kind = "point" if kindp == "point" else "fv"
                h = find_class_header(f.parent, cls) or find_class_header(
                    f.parent, re.sub(r"(Scalar|Vector|SphericalTensor|SymmTensor|Tensor)Field$",
                                     "Field", cls))
                if h is None:
                    hits = list(root.glob("src/**/" + re.sub(
                        r"(Scalar|Vector|SphericalTensor|SymmTensor|Tensor)Field$", "Field", cls) + ".H"))
                    hits = [x for x in hits if not SKIP_DIRS.intersection(x.parts)]
                    h = hits[0] if hits else None
                if h is None or CAP2TYPE.get(cap) is None:
                    continue
                add(kind, name, h, cls, [CAP2TYPE[cap]], f)
    for e in found.values():
        e["types"].sort(key=VALUE_TYPES.index)
    return found


def classify_role(patch):
    for role, rx in ROLE_RULES:
        if rx.search(patch):
            return role
    return None


def field_category(field):
    """Map a field name to a generic category used by the statistics."""
    base = field.split(".")[0]
    if field.startswith("alpha.") or field == "alpha1":
        return "alpha"
    return base


def scan_tutorials(root):
    """Scan the boundaryField of every field file in the tutorials.

    Returns (uses, roleStats):
      uses[(kind, type)] = {"refs": [(rel, patch)], "fields": Counter, "roles": Counter}
      roleStats[role][fieldCategory][type] = count
    """
    uses = {}
    role_stats = collections.defaultdict(lambda: collections.defaultdict(collections.Counter))
    tut = root / "tutorials"
    if not tut.is_dir():
        return uses, {}
    for f in sorted(tut.rglob("*")):
        rel_parts = f.relative_to(tut).parts
        if not any(re.match(r"^0(\.orig|\.org)?$", p) for p in rel_parts[:-1]):
            continue
        if not f.is_file() or f.stat().st_size > 400000 or f.suffix in (".gz",):
            continue
        text = read_text(f)
        if "boundaryField" not in text:
            continue
        field = re.sub(r"\.orig$", "", f.name)
        rel = str(f.relative_to(root))
        mc = CLASS_RE.search(text[:3000])
        if not mc:
            continue    # finite-area or surface fields
        kind = "point" if mc.group(1) == "point" else "fv"
        pats, _ = boundary_patches(f, text)
        for p in pats or []:
            t = p["type"]
            if not t or t.startswith("$"):
                continue
            u = uses.setdefault((kind, t), {"refs": [], "fields": collections.Counter(),
                                    "roles": collections.Counter()})
            if "from" not in p:
                u["refs"].append((rel, p["key"]))
            u["fields"][field_category(field)] += 1
            role = classify_role(p["key"])
            if role and kind == "fv":
                u["roles"][role] += 1
                role_stats[role][field_category(field)][t] += 1
    rs = {r: {fc: dict(cnt.most_common(8)) for fc, cnt in d.items()}
          for r, d in role_stats.items()}
    return uses, rs


def pick_refs(refs, n=30):
    """Choose up to n references, one per case directory first."""
    out, seen = [], set()
    for rel, patch in refs:
        case = rel.rsplit("/0", 1)[0]
        if case not in seen:
            seen.add(case)
            out.append(f"{rel}::{patch}")
            if len(out) >= n:
                return out
    for rel, patch in refs:
        s = f"{rel}::{patch}"
        if s not in out:
            out.append(s)
            if len(out) >= n:
                break
    return out


def tutorial_libs(root):
    """Map case directory -> libs listed in its system/controlDict."""
    out = {}
    tut = root / "tutorials"
    for cd in tut.rglob("controlDict"):
        if cd.parent.name != "system":
            continue
        m = LIBS_RE.search(strip_comments(read_text(cd)))
        if m:
            libs = [re.sub(r"^lib|\.so$", "", x.strip().strip('"'))
                    for x in m.group(1).split()]
            out[str(cd.parent.parent.relative_to(root))] = libs
    return out


def build_header_index(root):
    idx = {}
    for f in (root / "src").rglob("*.H"):
        if SKIP_DIRS.intersection(f.relative_to(root).parts):
            continue
        idx.setdefault(f.name, str(f.relative_to(root)))
    return idx


WALL_CHECK_RE = re.compile(r"!\s*isA<wallFvPatch>\s*\(\s*patch\(\)\s*\)\s*\)\s*\{\s*FatalError", re.S)


def wall_fatal(header):
    """True if the class sources abort when the patch is not of type wall."""
    stem = Path(header).with_suffix("")
    for ext in (".C", ".cxx", ".txx"):
        f = stem.with_suffix(ext)
        if f.is_file() and WALL_CHECK_RE.search(strip_comments(read_text(f))):
            return True
    return False


def make_tags(name, roles):
    low = name.lower()
    tags = [t for t, rx in TAG_RULES if re.search(rx, low)]
    total = sum(roles.values())
    if total >= 3:
        for r, n in roles.items():
            if n / total >= 0.4 and r in ("inlet", "outlet", "wall") and r not in tags:
                tags.append(r)
    return tags


def cmd_build(args):
    root = project_dir(args.src)
    print(f"Scanning {root} ...")
    regs = scan_registrations(root)
    uses, role_stats = scan_tutorials(root)
    case_libs = tutorial_libs(root)

    db = {"tool": "foamBC", "version": root.name, "built": date.today().isoformat(),
          "fv": {}, "point": {}, "bases": {}, "roleStats": role_stats}
    cls_to_name = {}
    for (kind, name), r in regs.items():
        cls_to_name.setdefault(r["cls"], name)
        # Typedef names of the templates (e.g. fixedValueFvPatchScalarField)
        for t in r["types"]:
            cap = t[0].upper() + t[1:]
            cls_to_name.setdefault(r["cls"].replace("PatchField", f"Patch{cap}Field"), name)

    for (kind, name), r in sorted(regs.items(), key=lambda kv: kv[0][1].lower()):
        h = r["header"]
        rel = str(h.relative_to(root))
        info = parse_header(h)
        example = pick_example(info["verbatims"], [name, name.split("::")[-1]])
        lib = lib_from_make(r["src"])
        parents = []
        for p in PARENT_RE.findall(info["text"]):
            if p != r["cls"] and p not in parents:
                parents.append(p)
        desc = info["description"]
        summary = desc.split("\n\n")[0].replace("\n", " ").strip()
        u = uses.get((kind, name), {"refs": [], "fields": collections.Counter(),
                            "roles": collections.Counter()})
        # libs that tutorials using this type load in controlDict
        libs_hint = []
        if lib and lib not in DEFAULT_LIBS:
            for rel_t, _ in u["refs"]:
                case = rel_t.rsplit("/0", 1)[0]
                if lib in case_libs.get(case, []):
                    libs_hint = [lib]
                    break
        group = guess_group(rel)
        if kind == "point" and group not in ("meshMotion", "point"):
            group = "point"
        e = {
            "name": name,
            "kind": kind,
            "class": r["cls"],
            "types": r["types"],
            "group": group,
            "header": rel,
            "library": lib if lib is not None else "",
            "libs": libs_hint,
            "summary": summary,
            "description": desc,
            "example": example,
            "otherExamples": [v for v in info["verbatims"] if v != example][:4],
            "tables": info["tables"],
            "inherited": info["inherited"],
            "parents": parents,
            "note": info["note"],
            "seeAlso": info["seeAlso"],
            "aliases": ALIASES.get(name, "") if kind == "fv" else "",
            "tutorials": pick_refs(u["refs"]),
            "tutorialCount": len(u["refs"]),
            "fields": dict(u["fields"].most_common(6)),
            "roles": dict(u["roles"].most_common()),
        }
        e["tags"] = make_tags(name, e["roles"])
        e["_wallFatal"] = wall_fatal(h)
        db[kind][name] = e

    # Ancestry: type names of the parent classes (transitive); parent classes
    # that are not selectable (e.g. nutWallFunction) are followed via headers
    hidx = build_header_index(root)
    fatal_cache = {}

    def class_info(cls):
        if cls not in fatal_cache:
            rel = hidx.get(cls + ".H")
            if rel:
                txt = read_text(root / rel)
                fatal_cache[cls] = (wall_fatal(root / rel),
                                    [p for p in PARENT_RE.findall(txt) if p != cls])
            else:
                fatal_cache[cls] = (False, [])
        return fatal_cache[cls]
    by_cls = {}
    for kind in ("fv", "point"):
        for e in db[kind].values():
            by_cls.setdefault(e["class"], e)
    for kind in ("fv", "point"):
        for e in db[kind].values():
            anc, todo, seen = [], list(e["parents"]), set()
            while todo:
                p = todo.pop(0)
                if p in seen:
                    continue
                seen.add(p)
                pe = by_cls.get(p)
                if pe is None:
                    base = re.sub(r"(FvPatch|PointPatch)(Scalar|Vector|SphericalTensor|"
                                  r"SymmTensor|Tensor)Field$", r"\1Field", p)
                    pe = by_cls.get(base)
                    nm = cls_to_name.get(p) or cls_to_name.get(base)
                else:
                    nm = pe["name"]
                if nm and nm not in anc and nm != e["name"]:
                    anc.append(nm)
                if pe:
                    todo.extend(pe["parents"])
                else:
                    fat, pp = class_info(p)
                    if fat:
                        e["_wallFatal"] = True
                    todo.extend(pp)
            e["ancestors"] = anc
            e["wallFunction"] = ("WallFunction" in e["name"] or
                                 any("WallFunction" in a for a in anc)) and kind == "fv"
            e["constraint"] = e["group"] == "constraint"
    names_fatal = {e["name"] for e in db["fv"].values() if e["_wallFatal"]}
    for kind in ("fv", "point"):
        for e in db[kind].values():
            e["wallOnly"] = kind == "fv" and (e["name"] in names_fatal or
                                              any(a in names_fatal for a in e["ancestors"]))
            del e["_wallFatal"]

    # Base headers documenting inherited entries
    wanted = list(dict.fromkeys(i for k in ("fv", "point") for e in db[k].values()
                                for i in e["inherited"]))
    bases = {}
    while wanted:
        name = wanted.pop(0)
        if name in bases:
            continue
        rel = hidx.get(name)
        if not rel:
            continue
        info = parse_header(root / rel)
        bases[name] = {
            "header": rel,
            "summary": info["description"].split("\n\n")[0].replace("\n", " "),
            "example": pick_example(info["verbatims"], []),
            "tables": info["tables"],
        }
    db["bases"] = bases

    out = Path(args.output) if args.output else user_db_path(root.name)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(db, indent=1, ensure_ascii=False), encoding="utf-8")

    fv = list(db["fv"].values())
    noex = sorted(e["name"] for e in fv if not e["example"])
    notab = sorted(e["name"] for e in fv if not e["tables"])
    unknown = sorted(t for k, t in uses if t not in db[k])
    print(f"Wrote {out}")
    if not args.output and current_version() != root.name:
        print(f"  note: used automatically when $WM_PROJECT_DIR ends with '{root.name}';"
              f" otherwise set FOAMBC_DB={out}")
    print(f"  fvPatchField types   : {len(fv)}")
    print(f"  pointPatchField types: {len(db['point'])}")
    print(f"  with example         : {len(fv) - len(noex)}")
    print(f"  with param table     : {len(fv) - len(notab)}")
    print(f"  used in tutorials    : {sum(1 for e in fv if e['tutorialCount'])}")
    print(f"  base headers         : {len(bases)}")
    if unknown:
        print(f"  tutorial types not in DB: {len(unknown)}"
              + (" (" + " ".join(unknown) + ")" if args.verbose else " (-v to list)"))
    if args.verbose:
        print("  no example    :", " ".join(noex) or "-")
        print("  no param table:", " ".join(notab) or "-")


