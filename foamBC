CONSTRAINT_PATCH_TYPES = {"empty", "wedge", "symmetryPlane", "symmetry", "cyclic",
                          "cyclicAMI", "cyclicACMI", "cyclicSlip", "processor",
                          "processorCyclic", "nonuniformTransformCyclic", "overset"}


def mesh_patches(case, region=None):
    """Return {name: {"type", "groups"}} from constant/polyMesh/boundary."""
    for fn in ("boundary", "boundary.gz"):
        p = case / "constant" / (region or "") / "polyMesh" / fn
        if p.is_file():
            masked = mask_comments(read_text(p))
            # Skip the FoamFile header
            m = re.search(r"^\s*\d+\s*\n\s*\(", masked, re.M) or re.search(r"^\s*\(", masked, re.M)
            start = m.end() if m else 0
            out = {}
            for e in dict_entries(masked, start, len(masked)):
                if e["kind"] != "dict" or e["key"] == "FoamFile":
                    continue
                body = masked[e["body"][0]:e["body"][1]]
                t = re.search(r"\btype\s+(\w+)\s*;", body)
                g = re.search(r"\binGroups\s+(?:List<word>\s*)?\d*\s*\(([^)]*)\)", body)
                out[e["key"]] = {"type": t.group(1) if t else "patch",
                                 "groups": g.group(1).split() if g else []}
            return out
    return None


NONUNIFORM = {}


def field_dir(case, region=None, time=None):
    if time:
        return case / time / (region or "")
    for t in ("0", "0.orig"):
        d = case / t / (region or "")
        if d.is_dir():
            return d
    return case / "0" / (region or "")


def case_fields(fdir):
    """Return {field: (path, kind, valueType, dimensions)} of the field files."""
    out = {}
    if not fdir.is_dir():
        return out
    for p in sorted(fdir.iterdir()):
        if not p.is_file() or p.name.startswith(".") or p.name.endswith((".bak", "~")):
            continue
        head = read_text(p)[:3000]
        m = CLASS_RE.search(head)
        if not m:
            continue
        dims = re.search(r"^\s*dimensions\s+\[([^\]]*)\]", read_text(p), re.M)
        name = re.sub(r"\.orig$", "", p.name)
        NONUNIFORM[str(p)] = bool(re.search(r"^\s*internalField\s+nonuniform", read_text(p), re.M))
        out[name] = (p, "point" if m.group(1) == "point" else "fv",
                     CAP2TYPE[m.group(2)], dims.group(1).split() if dims else None)
    return out


def match_patch(patches, name, groups):
    """Return the boundaryField entry applying to a mesh patch (OpenFOAM rules:
    exact name, then regular expressions (last first), then patch groups)."""
    for p in patches:
        if not p["quoted"] and p["key"] == name:
            return p
    for p in patches:
        if p["quoted"] and p["key"] == name:
            return p
    for p in reversed(patches):
        if p["quoted"]:
            try:
                if re.fullmatch(p["key"], name):
                    return p
            except re.error:
                pass
    for g in groups:
        for p in patches:
            if p["key"] == g:
                return p
    return None


def indent_block(text, n=4):
    return "\n".join((" " * n + l) if l.strip() else "" for l in text.splitlines())


def write_patch_entry(path, patch, entry, dry=False):
    """Replace or append the entry of 'patch' in the boundaryField of a field file."""
    text = read_text(path)
    masked = mask_comments(text)
    bf = find_boundary_field(masked)
    if not bf:
        return False, "no boundaryField"
    target = None
    shadowed = []
    for e in dict_entries(masked, bf[1], bf[2]):
        if e["kind"] == "dict" and e["key"] == patch:
            target = e
        elif e["kind"] == "dict" and e.get("quoted"):
            try:
                if re.fullmatch(e["key"], patch):
                    shadowed.append(e["key"])
            except re.error:
                pass
    new = indent_block(entry)
    if target:
        ls = text.rfind("\n", 0, target["start"]) + 1
        text2 = text[:ls] + new + text[target["end"]:]
        action = "replaced"
    else:
        # Before the closing brace of boundaryField
        close = bf[2]
        ls = text.rfind("\n", 0, close) + 1
        prev = text[:ls].rstrip("\n")
        text2 = prev + "\n\n" + new + "\n" + text[ls:]
        action = "appended"
        if shadowed:
            action += f" (overrides the regex entry \"{shadowed[-1]}\" for this patch)"
    if not dry:
        bak = path.with_name(path.name + ".bak")
        if not bak.exists():
            shutil.copy2(path, bak)
        path.write_text(text2, encoding="utf-8")
    return True, action


def case_or_exit(args):
    case = Path(args.case).resolve()
    if not (case / "system").is_dir() and not (case / "constant").is_dir():
        sys.exit(f"Error: {case} does not look like a case directory (use -case)")
    return case


def cmd_add(args):
    db = load_db()
    e = lookup(db, args.name, kind_of(args))
    patch = args.patch or "<patchName>"
    text = build_entry(e, patch, "full" if args.full else "minimal", db.get("bases"))
    vt_field = None
    if args.field:
        cf0 = case_fields(field_dir(Path(args.case).resolve(), args.region, args.time))
        if args.field in cf0:
            vt_field = cf0[args.field][2]
    if vt_field == "vector":
        text = re.sub(r"\buniform 0\b(\s*;)", r"uniform (0 0 0)\1", text)
        text = text.replace("  // Example for scalar field usage", "")
    stamp = date.today().isoformat()
    print(f"// Generated by foamBC from {e['header']} ({stamp})")
    print(text)
    placeholders = sorted(set(re.findall(r"<[\w ,:/|.\-]+>", strip_comments(text))))
    case = Path(args.case).resolve()
    if (case / "constant").is_dir() or (case / "system").is_dir():
        mp = mesh_patches(case, args.region) or {}
        if args.patch and mp:
            if args.patch not in mp:
                eprint(c(f"Warning: patch '{args.patch}' not in the mesh "
                         f"({' '.join(mp)})", "1;31", sys.stderr))
            else:
                for msg in compat_issues(e, mp[args.patch]["type"], None) + \
                        compat_warnings(e, mp[args.patch]["type"]):
                    eprint(c("Warning: " + msg, "1;31", sys.stderr))
        elif mp and not args.patch:
            eprint("mesh patches: " + " ".join(f"{k}({v['type']})" for k, v in mp.items()))
        if args.field:
            fdir = field_dir(case, args.region, args.time)
            fields = case_fields(fdir)
            if args.field not in fields:
                eprint(c(f"Warning: field file {fdir / args.field} not found", "1;31", sys.stderr))
            else:
                fpath, fkind, vt, _ = fields[args.field]
                if vt not in e["types"]:
                    eprint(c(f"Error: '{e['name']}' is not available for {vt} fields "
                             f"(types: {', '.join(e['types'])})", "1;31", sys.stderr))
                    sys.exit(1)
                if args.insert:
                    if not args.patch:
                        sys.exit("Error: --insert needs -patch")
                    ok, act = write_patch_entry(fpath, args.patch, text)
                    if not ok:
                        sys.exit(f"Error: {fpath}: {act}")
                    eprint(f"{act} patch '{args.patch}' in {fpath} (backup: {fpath.name}.bak)")
    elif args.insert:
        sys.exit(f"Error: {case} does not look like a case directory (use -case)")
    if args.insert and not args.field:
        sys.exit("Error: --insert needs -field")
    if e["libs"]:
        eprint(f"Note: add  libs ({' '.join(e['libs'])});  to system/controlDict "
               f"unless the solver already links it")
    if placeholders:
        eprint(c("Edit these placeholders before running: ", "1;31", sys.stderr) +
               " ".join(placeholders))


