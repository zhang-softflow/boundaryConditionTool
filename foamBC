def cmd_html(args):
    db = load_db()
    if not HTML_TEMPLATE.is_file():
        sys.exit(f"Error: template {HTML_TEMPLATE} not found")
    for e in db["fv"].values():
        e["entry"] = build_entry(e, "<patchName>", "minimal", db.get("bases"))
    for e in db["point"].values():
        e["entry"] = build_entry(e, "<patchName>", "minimal", db.get("bases"))
    db["roles"] = ROLES
    data = json.dumps(db, ensure_ascii=False).replace("</", "<\\/")
    page = read_text(HTML_TEMPLATE).replace("/*__BC_DATA__*/null", data)
    out = Path(args.output) if args.output else HTML_FILE
    out.write_text(page, encoding="utf-8")
    print(f"Wrote {out}")


# ---------------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(prog="foamBC", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    def case_opts(s):
        s.add_argument("-case", "--case", default=".", help="case directory (default: cwd)")
        s.add_argument("-region", "--region", help="region name (multi-region cases)")
        s.add_argument("-time", "--time", help="field directory (default: 0, else 0.orig)")

    s = sub.add_parser("build", help="scan OpenFOAM sources and build the database")
    s.add_argument("--src", help="OpenFOAM source root (default: $WM_PROJECT_DIR)")
    s.add_argument("-o", "--output",
                   help="database file (default: ~/.local/share/foamBC/bcDatabase-<version>.json)")
    s.add_argument("-v", "--verbose", action="store_true")
    s.set_defaults(func=cmd_build)

    s = sub.add_parser("list", help="list boundary conditions")
    s.add_argument("-g", "--group", help="filter by group (basic, constraint, derived, "
                                         "wallFunction, turbulence, thermal, ...)")
    s.add_argument("-t", "--tag", help="filter by tag (inlet, outlet, wall, pressure, ...)")
    s.add_argument("--type", help="value type (scalar, vector, symmTensor, ...)")
    s.add_argument("-u", "--used", action="store_true", help="only types used in the tutorials, "
                                                             "most used first")
    s.add_argument("--groups", action="store_true", help="list groups with counts")
    s.add_argument("--point", action="store_true", help="point patch fields (mesh motion)")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("search", help="search names/descriptions (all keywords must match)")
    s.add_argument("keywords", nargs="+")
    s.add_argument("-m", "--max", type=int, default=25)
    s.add_argument("--point", action="store_true")
    s.set_defaults(func=cmd_search)

    s = sub.add_parser("show", help="show documentation of a boundary condition")
    s.add_argument("name")
    s.add_argument("-i", "--inherited", action="store_true", help="also show inherited entries")
    s.add_argument("--more", action="store_true", help="show additional header examples")
    s.add_argument("-m", "--max", type=int, default=6, help="max tutorial paths to list")
    s.add_argument("--point", action="store_true")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("example", help="print patch entries taken from the tutorials")
    s.add_argument("name")
    s.add_argument("-m", "--max", type=int, default=3)
    s.add_argument("-f", "--field", help="prefer examples of this field (U, p, k, ...)")
    s.add_argument("--src", help="OpenFOAM source root (default: $WM_PROJECT_DIR)")
    s.add_argument("--point", action="store_true")
    s.set_defaults(func=cmd_example)

    s = sub.add_parser("typical", help="most common types of a field per patch role")
    s.add_argument("field", help="field name, e.g. U, p, p_rgh, k, epsilon, omega, nut, T, alpha.water")
    s.add_argument("-r", "--role", help="inlet, outlet, wall, atmosphere, farfield, symmetry")
    s.add_argument("-m", "--max", type=int, default=6)
    s.set_defaults(func=cmd_typical)

    s = sub.add_parser("add", help="generate one patch entry (print, or write with --insert)")
    s.add_argument("name", help="boundary condition type, e.g. inletOutlet")
    case_opts(s)
    s.add_argument("-patch", "--patch", help="patch name")
    s.add_argument("-field", "--field", help="field file name in 0/, e.g. U")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--minimal", action="store_true", help="mandatory entries only (default)")
    g.add_argument("--full", action="store_true", help="also list optional entries as comments")
    s.add_argument("--insert", action="store_true",
                   help="replace/append the patch entry in 0/<field> (backup .bak)")
    s.add_argument("--point", action="store_true")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("recipe", help="entries of all fields for a patch role "
                                      "(velocityInlet, pressureOutlet, wall, ...)")
    s.add_argument("role", nargs="?", help="patch role (omit or --list to list them)")
    case_opts(s)
    s.add_argument("-patch", "--patch", help="patch name")
    s.add_argument("--fields", help="field names when there is no case, e.g. U,p,k,epsilon,nut")
    s.add_argument("--list", action="store_true", help="list the roles")
    s.add_argument("--U", help="velocity: vector '(10 0 0)' or normal inflow speed '10'")
    s.add_argument("--p", help="static/ambient pressure in the units of the p field")
    s.add_argument("--p0", help="total pressure (totalPressureInlet, openAtmosphere)")
    s.add_argument("--T", help="inlet / ambient temperature [K]")
    s.add_argument("--Tw", help="wall temperature [K] (default: adiabatic)")
    s.add_argument("--I", help="turbulence intensity (default 0.05)")
    s.add_argument("--L", help="turbulent mixing length [m]")
    s.add_argument("--Q", help="volumetric flow rate [m3/s] (flowRateInlet)")
    s.add_argument("--mdot", help="mass flow rate [kg/s] (flowRateInlet)")
    s.add_argument("--rhoInlet", help="density for --mdot if rho is not a field")
    s.add_argument("--alpha", help="phase fraction at the inlet (VoF)")
    s.add_argument("--ctype", help="constraint type for role symmetry when the mesh is unknown")
    s.add_argument("--compressible", action="store_true",
                   help="pressure in Pa (detected from the dimensions of 0/p)")
    s.add_argument("--insert", action="store_true",
                   help="write the entries into every field file (backup .bak)")
    s.set_defaults(func=cmd_recipe)

    s = sub.add_parser("check", help="check the boundary conditions of a case")
    case_opts(s)
    s.add_argument("--fields", help="only these fields (comma separated)")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("html", help="generate catalog.html")
    s.add_argument("-o", "--output")
    s.set_defaults(func=cmd_html)

    args = p.parse_args()
    try:
        args.func(args)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
