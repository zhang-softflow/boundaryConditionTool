def find_db():
    env = os.environ.get("FOAMBC_DB")
    if env:
        if not Path(env).is_file():
            sys.exit(f"Error: FOAMBC_DB={env} not found.")
        return Path(env)
    ver = current_version()
    if ver and user_db_path(ver).is_file():
        return user_db_path(ver)
    return BUNDLED_DB


_DB = None


def load_db():
    global _DB
    if _DB is not None:
        return _DB
    path = find_db()
    if not path.is_file():
        sys.exit("Error: database not found. Run 'foamBC build' first.")
    db = json.loads(path.read_text(encoding="utf-8"))
    ver = current_version()
    if ver and path == BUNDLED_DB and db.get("version") != ver and not os.environ.get("FOAMBC_QUIET"):
        print(f"Warning: bundled database is for {db.get('version')}, but the "
              f"environment is {ver}. Run 'foamBC build' for an exact match.",
              file=sys.stderr)
    _DB = db
    return db


def use_color(stream=None):
    return (stream or sys.stdout).isatty() and not os.environ.get("NO_COLOR")


def c(text, code, stream=None):
    return f"\033[{code}m{text}\033[0m" if use_color(stream) else text


def eprint(*a):
    print(*a, file=sys.stderr)


def kind_of(args):
    return "point" if getattr(args, "point", False) else "fv"


def lookup(db, name, kind="fv", exit_on_fail=True):
    tbl = db[kind]
    if name in tbl:
        return tbl[name]
    low = name.lower()
    for k, e in tbl.items():
        if k.lower() == low or k.split("::")[-1].lower() == low:
            return e
    if not exit_on_fail:
        return None
    close = [k for k in tbl if low in k.lower()]
    msg = f"Error: unknown {'point' if kind == 'point' else ''} boundary condition '{name}'."
    other = "fv" if kind == "point" else "point"
    if name in db[other]:
        msg += f" ('{name}' exists as a {other} patch field: " + \
               ("use --point)" if other == "point" else "drop --point)")
    if close:
        msg += " Did you mean: " + ", ".join(sorted(close, key=len)[:10]) + " ?"
    sys.exit(msg)


def type_abbrev(types):
    if types == VALUE_TYPES:
        return "all"
    ab = {"scalar": "S", "vector": "V", "sphericalTensor": "sT", "symmTensor": "sym",
          "tensor": "T"}
    return ",".join(ab[t] for t in types)


def print_rows(entries):
    w = max([len(e["name"]) for e in entries] + [4])
    for e in entries:
        flag = "T" if e["tutorialCount"] else " "
        flag += "W" if e["wallOnly"] else ("w" if e.get("wallFunction") else
                                           ("C" if e["constraint"] else " "))
        s = e["summary"]
        if len(s) > 70:
            s = s[:67] + "..."
        print(f"{c(e['name'].ljust(w), '1;36')}  {flag}  {type_abbrev(e['types']):<9} "
              f"{e['group']:<13} {s}")


def legend():
    return ("T: used in tutorials, W: wall patches only (w: wall function), C: constraint type "
            "(must match the mesh patch type); value types S=scalar V=vector ...")


def cmd_list(args):
    db = load_db()
    es = list(db[kind_of(args)].values())
    if args.group:
        es = [e for e in es if args.group.lower() in e["group"].lower()]
    if args.tag:
        es = [e for e in es if args.tag in e["tags"]]
    if args.type:
        es = [e for e in es if args.type in e["types"]]
    if args.used:
        es = [e for e in es if e["tutorialCount"]]
        es.sort(key=lambda e: -e["tutorialCount"])
    if args.groups:
        cnt = collections.Counter(e["group"] for e in es)
        for g, n in sorted(cnt.items()):
            print(f"{g:<16}{n}")
        return
    print_rows(es)
    print(f"\n{len(es)} entries  ({legend()})")


def cmd_search(args):
    db = load_db()
    words = [w.lower() for w in args.keywords]
    hits = []
    for e in db[kind_of(args)].values():
        names = e["name"].lower()
        hay = " ".join([names, e["description"], e["header"], e.get("aliases", ""),
                        " ".join(e["tags"]), " ".join(e["fields"]),
                        " ".join(r["name"] for t in e["tables"] for r in t["rows"])]).lower()
        if all(w in hay for w in words):
            score = sum(3 for w in words if w in names) + \
                sum(1 for w in words if w in e["summary"].lower()) + \
                sum(2 for w in words if w in e.get("aliases", "").lower()) + \
                min(e["tutorialCount"], 200) / 50.0
            hits.append((-score, e["name"].lower(), e))
    if not hits:
        print("No match. Try English keywords or 'foamBC list'.")
        return
    print_rows([h[2] for h in sorted(hits)][: args.max])
    if len(hits) > args.max:
        print(f"... {len(hits) - args.max} more (use -m)")


def format_tables(tables, only_required=False):
    out = []
    for t in tables:
        rows = [r for r in t["rows"] if not only_required or r["reqd"] == "yes"]
        if not rows:
            continue
        if t["heading"]:
            out.append(c(f"  [{t['heading']}]", "1"))
        wn = max(len(r["name"]) for r in rows)
        wt = max([len(r["type"]) for r in rows] + [4])
        out.append(f"  {'Property'.ljust(wn)}  {'Type'.ljust(wt)}  Reqd  Default        Description")
        for r in rows:
            name = r["name"].ljust(wn)
            if r["reqd"] == "yes":
                name = c(name, "1;31")
            elif r["reqd"] == "cond":
                name = c(name, "1;35")
            out.append(f"  {name}  {r['type'].ljust(wt)}  {r['reqd'][:4]:<4}  "
                       f"{(r['default'] or '-')[:13]:<13}  {r['desc']}")
    return "\n".join(out)


