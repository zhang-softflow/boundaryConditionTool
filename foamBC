ROLES = collections.OrderedDict([
    ("velocityInlet", "fixed velocity inlet (--U vector or normal speed); turbulence from "
                      "intensity --I and mixing length --L"),
    ("flowRateInlet", "inlet with volumetric (--Q m3/s) or mass (--mdot kg/s) flow rate"),
    ("pressureOutlet", "fixed static pressure outlet (--p), backflow-safe (inletOutlet)"),
    ("totalPressureInlet", "inlet with fixed total pressure (--p0), velocity from the flux"),
    ("openAtmosphere", "open boundary to the ambient (total pressure --p0, in- and outflow), "
                       "e.g. 'atmosphere' of interFoam"),
    ("farfield", "free-stream boundary of external flows (--U, --p)"),
    ("wall", "stationary no-slip wall with wall functions (--Tw fixes the temperature)"),
    ("movingWall", "wall moving tangentially with velocity --U (lid-driven cavity)"),
    ("slipWall", "frictionless wall (slip)"),
    ("symmetry", "constraint types: the type of the mesh patch is used for every field "
                 "(symmetryPlane, symmetry, empty, wedge, cyclic, ...)"),
])

ROLE_ALIASES = {
    "inlet": "velocityInlet", "velocity": "velocityInlet", "flowrate": "flowRateInlet",
    "massflowinlet": "flowRateInlet", "outlet": "pressureOutlet", "atmosphere": "openAtmosphere",
    "open": "openAtmosphere", "opening": "openAtmosphere", "totalpressure": "totalPressureInlet",
    "freestream": "farfield", "noslip": "wall", "lid": "movingWall", "slip": "slipWall",
    "constraint": "symmetry", "symmetryplane": "symmetry", "empty": "symmetry",
    "wedge": "symmetry", "cyclic": "symmetry",
}

TURB_FIELDS = {"k", "epsilon", "omega", "nut", "nuTilda", "alphat", "kl", "kt",
               "v2", "f", "ReThetat", "gammaInt", "R", "nuSgs", "muSgs", "alphaSgs"}


class Ctx:
    """Case-wide settings used by the recipes."""

    def __init__(self, fields, args):
        self.fields = fields                       # {name: valueType}
        self.dims = {}
        self.prgh = "p_rgh" in fields
        self.args = args
        self.compressible = False
        self.notes = []
        self.internal = {}       # uniform internalField values

    def set_dims(self, name, dims):
        self.dims[name] = dims
        if name == "p" and dims and dims[0] in ("1", "1.0"):
            self.compressible = True

    def val(self, attr, placeholder):
        v = getattr(self.args, attr, None)
        return v if v not in (None, "") else placeholder

    @property
    def p_ambient(self):
        if self.args.p:
            return self.args.p
        if self.compressible:
            # Default to the initial pressure of the case
            return self.internal.get("p", "1e5")
        return "0"


def is_vector_value(s):
    return s.strip().startswith("(")


def fmt_vec(s):
    s = s.strip()
    if s.startswith("("):
        return " ".join(s.split())
    parts = s.replace(",", " ").split()
    return "(" + " ".join(parts) + ")" if len(parts) == 3 else s


def entry(patch, lines, comment=None):
    body = "\n".join("    " + (f"{k:<15} {v};" if v is not None else k)
                     for k, v in lines)
    head = f"// {comment}\n" if comment else ""
    return f"{head}{patch}\n{{\n{body}\n}}"


def recipe_entry(role, field, vt, ctx, patch, ptype=None):
    """Return (lines, comment) for one field of a recipe, or None to skip."""
    a = ctx.args
    cat = field_category(field)
    I = ctx.val("I", "0.05")
    L = ctx.val("L", "<mixingLength [m], e.g. 0.07*hydraulicDiameter>")
    if role == "symmetry":
        t = ptype if ptype in CONSTRAINT_PATCH_TYPES else ctx.val("ctype", "symmetryPlane")
        return [("type", t)], None

    is_wall = role in ("wall", "movingWall", "slipWall")
    # --- pressure -------------------------------------------------------------
    if field == "p" and ctx.prgh:
        return [("type", "calculated"), ("value", "$internalField")], \
            "p is calculated from p_rgh"
    if field in ("p", "p_rgh"):
        prgh = field == "p_rgh"
        if role in ("velocityInlet", "flowRateInlet") or is_wall:
            if prgh:
                return [("type", "fixedFluxPressure"), ("value", "$internalField")], None
            return [("type", "zeroGradient")], None
        if role == "pressureOutlet":
            p = ctx.p_ambient
            if prgh:
                return [("type", "prghPressure"), ("p", f"uniform {p}"),
                        ("value", "$internalField")], "static pressure p (not p_rgh) at the outlet"
            return [("type", "fixedValue"), ("value", f"uniform {p}")], None
        if role in ("totalPressureInlet", "openAtmosphere"):
            p0 = ctx.val("p0", ctx.p_ambient if role == "openAtmosphere" else "<p0>")
            if prgh:
                return [("type", "prghTotalPressure"), ("p0", f"uniform {p0}"),
                        ("value", "$internalField")], "total pressure p0 (of p, not p_rgh)"
            return [("type", "totalPressure"), ("p0", f"uniform {p0}"),
                    ("value", "$internalField")], None
        if role == "farfield":
            return [("type", "freestreamPressure"),
                    ("freestreamValue", f"uniform {ctx.p_ambient}")], None
    # --- velocity -------------------------------------------------------------
    if cat == "U" and vt == "vector":
        U = ctx.val("U", "<(Ux Uy Uz)>")
        if role == "velocityInlet":
            if a.U and not is_vector_value(a.U) and len(a.U.replace(",", " ").split()) == 1:
                return [("type", "surfaceNormalFixedValue"), ("refValue", f"uniform -{a.U.lstrip('-')}"),
                        ("value", "$internalField")], \
                    "normal inflow speed (negative = into the domain)"
            return [("type", "fixedValue"), ("value", f"uniform {fmt_vec(U)}")], None
        if role == "flowRateInlet":
            if a.mdot:
                if ctx.compressible and not a.rhoInlet:
                    return [("type", "flowRateInletVelocity"), ("massFlowRate", a.mdot),
                            ("value", "uniform (0 0 0)")], "massFlowRate [kg/s], uses the rho field"
                return [("type", "flowRateInletVelocity"), ("massFlowRate", a.mdot),
                        ("rhoInlet", ctx.val("rhoInlet", "<rho [kg/m3]>")),
                        ("value", "uniform (0 0 0)")], \
                    "massFlowRate [kg/s]; rhoInlet is used when there is no rho field"
            return [("type", "flowRateInletVelocity"),
                    ("volumetricFlowRate", ctx.val("Q", "<Q [m3/s]>")),
                    ("value", "uniform (0 0 0)")], \
                "volumetricFlowRate [m3/s]"
        if role == "pressureOutlet":
            return [("type", "inletOutlet"), ("inletValue", "uniform (0 0 0)"),
                    ("value", "$internalField")], "zeroGradient for outflow, 0 for backflow"
        if role in ("totalPressureInlet", "openAtmosphere"):
            return [("type", "pressureInletOutletVelocity"), ("value", "uniform (0 0 0)")], None
        if role == "farfield":
            return [("type", "freestreamVelocity"), ("freestreamValue", f"uniform {fmt_vec(U)}")], None
        if role == "wall":
            return [("type", "noSlip")], None
        if role == "movingWall":
            return [("type", "fixedValue"), ("value", f"uniform {fmt_vec(U)}")], \
                "tangential wall velocity (use movingWallVelocity for moving meshes)"
        if role == "slipWall":
            return [("type", "slip")], None
    # --- turbulence -----------------------------------------------------------
    inflow = role in ("velocityInlet", "flowRateInlet")
    backflow = role in ("pressureOutlet", "totalPressureInlet", "openAtmosphere")
    if cat == "k":
        if inflow:
            return [("type", "turbulentIntensityKineticEnergyInlet"), ("intensity", I),
                    ("value", "$internalField")], "k from the turbulence intensity"
        if is_wall and role != "slipWall":
            return [("type", "kqRWallFunction"), ("value", "$internalField")], None
    if cat == "epsilon":
        if inflow:
            return [("type", "turbulentMixingLengthDissipationRateInlet"),
                    ("mixingLength", L), ("value", "$internalField")], None
        if is_wall and role != "slipWall":
            return [("type", "epsilonWallFunction"), ("value", "$internalField")], None
    if cat == "omega":
        if inflow:
            return [("type", "turbulentMixingLengthFrequencyInlet"),
                    ("mixingLength", L), ("value", "$internalField")], None
        if is_wall and role != "slipWall":
            return [("type", "omegaWallFunction"), ("value", "$internalField")], None
    if cat == "nut":
        if is_wall and role != "slipWall":
            wf = "nutUSpaldingWallFunction" if "nuTilda" in ctx.fields else "nutkWallFunction"
            return [("type", wf), ("value", "uniform 0")], None
        return [("type", "calculated"), ("value", "uniform 0")], None
    if cat == "alphat":
        if is_wall and role != "slipWall":
            if ctx.compressible:
                return [("type", "compressible::alphatWallFunction"), ("Prt", "0.85"),
                        ("value", "uniform 0")], None
            return [("type", "alphatJayatillekeWallFunction"), ("Prt", "0.85"),
                    ("value", "uniform 0")], None
        return [("type", "calculated"), ("value", "uniform 0")], None
    if cat == "nuTilda" and is_wall and role != "slipWall":
        return [("type", "fixedValue"), ("value", "uniform 0")], None
    # --- temperature ----------------------------------------------------------
    if cat == "T" and vt == "scalar":
        if inflow:
            return [("type", "fixedValue"), ("value", f"uniform {ctx.val('T', '<T_inlet [K]>')}")], None
        if is_wall and role != "slipWall":
            if a.Tw:
                return [("type", "fixedValue"), ("value", f"uniform {a.Tw}")], None
            return [("type", "zeroGradient")], "adiabatic wall (--Tw for a fixed temperature)"
        if backflow:
            return [("type", "inletOutlet"),
                    ("inletValue", f"uniform {ctx.val('T', '<T_ambient [K]>')}"),
                    ("value", "$internalField")], None
        if role == "farfield":
            return [("type", "inletOutlet"),
                    ("inletValue", f"uniform {ctx.val('T', '$internalField')}".replace("uniform $", "$")),
                    ("value", "$internalField")], None
    # --- phase fraction -------------------------------------------------------
    if cat == "alpha" and vt == "scalar":
        if inflow:
            return [("type", "fixedValue"), ("value", f"uniform {ctx.val('alpha', '<alpha_inlet 0..1>')}")], None
        if backflow or role == "farfield":
            return [("type", "inletOutlet"), ("inletValue", f"uniform {ctx.val('alpha', '0')}"),
                    ("value", "$internalField")], "phase fraction entering through backflow"
        if is_wall:
            return [("type", "zeroGradient")], None
    # --- generic --------------------------------------------------------------
    zero = "uniform (0 0 0)" if vt == "vector" else "uniform 0"
    if inflow:
        return [("type", "fixedValue"), ("value", "$internalField")], \
            f"inlet value of {field} (set it, $internalField = initial value)"
    if backflow or role == "farfield":
        return [("type", "inletOutlet"), ("inletValue", "$internalField"),
                ("value", "$internalField")], None
    if role == "slipWall":
        return [("type", "slip")], None
    if is_wall:
        if cat in TURB_FIELDS:
            ctx.notes.append(f"{field}: no standard wall function known; check the "
                             f"turbulence model documentation")
        return [("type", "zeroGradient")], None
    return [("type", "zeroGradient")], None


def cmd_recipe(args):
    if args.list or not args.role:
        print(c("Patch roles", "1"))
        for r, d in ROLES.items():
            print(f"  {c(r.ljust(20), '1;36')} {d}")
        print("\nExample: foamBC recipe velocityInlet -case . -patch inlet --U '(10 0 0)' --I 0.05 --L 0.01")
        return
    role = args.role
    if role not in ROLES:
        role = ROLE_ALIASES.get(role.lower().replace("_", ""), role)
    if role not in ROLES:
        sys.exit(f"Error: unknown role '{args.role}'. Roles: {', '.join(ROLES)}")
    db = load_db()
    case = Path(args.case).resolve()
    have_case = (case / "system").is_dir() or (case / "constant").is_dir()
    fdir = field_dir(case, args.region, args.time) if have_case else None
    cf = case_fields(fdir) if fdir else {}
    if args.fields:
        want = args.fields.replace(",", " ").split()
        guess = {"U": "vector"}
        fields = collections.OrderedDict(
            (f, cf[f][2] if f in cf else guess.get(field_category(f), "scalar")) for f in want)
    elif cf:
        fields = collections.OrderedDict((k, v[2]) for k, v in cf.items() if v[1] == "fv")
    else:
        sys.exit("Error: no case field files found; give the fields with --fields "
                 "(e.g. --fields U,p,k,epsilon,nut)")
    ctx = Ctx(fields, args)
    for k, v in cf.items():
        ctx.set_dims(k, v[3])
        m = re.search(r"^\s*internalField\s+uniform\s+([^;]+);", read_text(v[0]), re.M)
        if m:
            ctx.internal[k] = m.group(1).strip()
    if args.compressible:
        ctx.compressible = True
    patch = args.patch or "<patchName>"
    ptype = None
    mp = mesh_patches(case, args.region) if have_case else None
    if mp and args.patch:
        if args.patch not in mp:
            eprint(c(f"Warning: patch '{args.patch}' not in the mesh ({' '.join(mp)})",
                     "1;31", sys.stderr))
        else:
            ptype = mp[args.patch]["type"]
    if ptype in CONSTRAINT_PATCH_TYPES and role != "symmetry":
        eprint(c(f"Note: mesh patch '{patch}' is of constraint type '{ptype}': "
                 f"using role 'symmetry' (type {ptype} for all fields)", "1;33", sys.stderr))
        role = "symmetry"
    if role in ("wall", "movingWall") and ptype and ptype != "wall":
        eprint(c(f"Warning: mesh patch '{patch}' is of type '{ptype}', wall functions need "
                 f"type 'wall' (change it in blockMeshDict/constant/polyMesh/boundary)",
                 "1;31", sys.stderr))
    if role == "symmetry" and ptype is None and not args.ctype:
        eprint("Note: mesh patch type unknown; using symmetryPlane (set --ctype)")

    blocks = []
    rs = db.get("roleStats", {})
    stat_role = {"velocityInlet": "inlet", "flowRateInlet": "inlet", "pressureOutlet": "outlet",
                 "totalPressureInlet": "inlet", "openAtmosphere": "atmosphere",
                 "farfield": "farfield", "wall": "wall", "movingWall": "wall",
                 "slipWall": "wall", "symmetry": "symmetry"}[role]
    for f, vt in fields.items():
        res = recipe_entry(role, f, vt, ctx, patch, ptype)
        if res is None:
            continue
        lines, comment = res
        t = lines[0][1]
        if f in cf and NONUNIFORM.get(str(cf[f][0])):
            # '$internalField' would expand to a list of the size of the mesh
            zero = "uniform (0 0 0)" if vt == "vector" else "uniform 0"
            fixed = []
            for k, v in lines:
                if v == "$internalField":
                    v = zero if k == "value" else f"<{k} of {f}: uniform ...>"
                fixed.append((k, v))
            lines = fixed
            ctx.notes.append(f"{f}: internalField is nonuniform, '$internalField' replaced")
        top = rs.get(stat_role, {}).get(field_category(f), {})
        most = None
        if role != "symmetry" and top:
            best = next(iter(top))
            if best != t and top[best] > 2 * top.get(t, 0):
                most = f"most used in tutorials: {best} ({top[best]}x)"
        e = lookup(db, t, "fv", exit_on_fail=False)
        if e is None:
            ctx.notes.append(f"{f}: type '{t}' not found in the database of {db['version']}")
        elif vt not in e["types"]:
            ctx.notes.append(f"{f}: type '{t}' is not available for {vt} fields")
        n = rs.get(stat_role, {}).get(field_category(f), {}).get(t) if role != "symmetry" else None
        ev = f"tutorials: {n}x on {stat_role} patches" if n else None
        cm = "; ".join(x for x in (comment, ev, most) if x)
        blocks.append((f, vt, entry(patch, lines), cm))

    print(c(f"// Recipe '{role}' for patch '{patch}'"
            + (f" (mesh type {ptype})" if ptype else ""), "1"))
    for f, vt, text, cm in blocks:
        print(c(f"// ---- {(fdir.name + '/') if fdir else '0/'}{f}" + (f"   ({cm})" if cm else ""),
                "1;32"))
        print(text)
        print()
    placeholders = sorted(set(p for _, _, t, _ in blocks
                              for p in re.findall(r"<[^<>\n]+>", t)))
    for n in dict.fromkeys(ctx.notes):
        eprint(c("Note: " + n, "1;33", sys.stderr))
    if args.insert:
        if not have_case:
            sys.exit("Error: --insert needs a case directory (-case)")
        if not args.patch:
            sys.exit("Error: --insert needs -patch")
        if placeholders:
            sys.exit(c("Error: fill these values first (options --U --p --p0 --T --L ...): ",
                       "1;31", sys.stderr) + " ".join(placeholders))
        for f, vt, text, _ in blocks:
            if f not in cf:
                eprint(f"skip {f}: no file {fdir / f}")
                continue
            ok, act = write_patch_entry(cf[f][0], args.patch, text)
            eprint(f"{f:<12} {act}" if ok else f"{f:<12} ERROR {act}")
        eprint(f"Backups: <field>.bak in {fdir}. Check with: foamBC check -case {args.case}")
    elif placeholders:
        eprint(c("Values to fill (or pass --U --p --p0 --T --Tw --I --L --Q --mdot --alpha): ",
                 "1;31", sys.stderr) + " ".join(placeholders))
    elif have_case and args.patch:
        eprint(f"(use --insert to write these entries into {fdir})")


